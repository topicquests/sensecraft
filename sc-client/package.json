{
  "name": "sensecraft",
  "version": "0.0.1",
  "description": "A Collective Sensemaking Game",
  "productName": "SenseCraft App",
  "author": "Byron Coughlin <byroncoughlinsr@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "prepare": "quasar prepare",
    "playwright:install": "playwright install",
    "dev": "quasar dev",
    "build": "quasar build",
    "test:scoring": "cucumber-js -t @scoring",
    "test:cucumber": "cucumber-js --require ts-node/register --import src/tests/stepDefinitions/**/*.ts",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "test:playwright": "playwright install && playwright test src/tests/e2e -j1",
    "test:playwright:ui": "playwright install && playwright test src/tests/e2e --ui -j1",
    "test:e2e:ordered": "ts-node scripts/generate-e2e-command.ts"
  },
  "dependencies": {
    "@quasar/babel-preset-app": "~2.0",
    "@quasar/extras": "~1.17",
    "axios": "~1.13",
    "jwt-decode": "~4.0",
    "libqp": "~2.1",
    "pinia": "~3.0",
    "quasar": "~2.18",
    "robust-websocket": "~1.0",
    "vue": "~3.5",
    "vue-i18n": "~11"
  },
  "devDependencies": {
    "@babel/core": "^7.26",
    "@babel/eslint-parser": "~7",
    "@babel/preset-env": "^7.26",
    "@babel/preset-typescript": "^7.26",
    "@cucumber/cucumber": "~12",
    "@cucumber/messages": "~31",
    "@cucumber/pretty-formatter": "~2",
    "@intlify/unplugin-vue-i18n": "~11",
    "@pinia/testing": "~1",
    "@playwright/test": "~1.56",
    "@quasar/app-vite": "^2.3.0",
    "@quasar/cli": "^2.5.0",
    "@quasar/quasar-app-extension-testing": "^2.2.0",
    "@quasar/quasar-app-extension-testing-unit-vitest": "~1.2",
    "@quasar/vite-plugin": "~1.10",
    "@testing-library/vue": "~8.1",
    "@tsconfig/recommended": "~1.0",
    "@types/libqp": "~1.1",
    "@types/luxon": "~3.7",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "~8",
    "@typescript-eslint/parser": "~8",
    "@vitejs/plugin-vue": "~6",
    "@vitest/browser": "^3.2",
    "@vue/eslint-config-typescript": "~14",
    "@vue/test-utils": "^2.4.6",
    "@vue/typescript": "~1.8",
    "autoprefixer": "~10.4",
    "axios-mock-adapter": "~2.1",
    "chai": "~6.2",
    "cucumber-tsflow": "~4.6",
    "eslint": "~9",
    "eslint-config-prettier": "~10",
    "eslint-plugin-cucumber": "~2.0",
    "eslint-plugin-markdown": "~5.1",
    "eslint-plugin-vue": "~10",
    "jsdom": "~27",
    "jws": "~4",
    "prettier": "~3.6",
    "selenium-webdriver": "~4.38",
    "ts-node-maintained": "^10.9.5",
    "tsconfig-paths": "~4.2",
    "typescript": "~5.9",
    "vite": "~7.2",
    "vitest": "^3.2.4",
    "vue-router": "^4.6.3",
    "vue-test-utils": "^0.5.0",
    "vue-tsc": "~3.1"
  },
  "engines": {
    "node": "^20 || ^18 || ^16 || ^14.19",
    "npm": ">= 6.13.4"
  },
  "resolutions": {
    "ts-node": "11.0.0-beta.1"
  },
  "overrides": {
    "ts-node": "11.0.0-beta.1"
  }
}
